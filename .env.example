# Cloudflare credentials for deploying Submission Desk to Cloudflare Pages.
#
# 1. Copy this file to `.env`  ->  cp .env.example .env
# 2. Paste your API token below. `.env` is gitignored — never commit it.
# 3. Deploy locally:            ->  ./tools/deploy.sh
#
# API token: Cloudflare dashboard -> My Profile -> API Tokens
#   -> Create Token -> "Cloudflare Pages — Edit" template (least-privilege).
CLOUDFLARE_API_TOKEN=

# Account ID: run `npx wrangler whoami`, or Cloudflare dashboard -> Workers & Pages
# (right sidebar). Not secret, but kept here so tools/deploy.sh can read it.
CLOUDFLARE_ACCOUNT_ID=

# Optional: override the Pages project name (defaults to "submission-desk").
# CF_PAGES_PROJECT=submission-desk
